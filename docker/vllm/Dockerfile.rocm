ARG BASE_IMAGE=vllm/vllm-openai-rocm:v0.21.0

FROM ${BASE_IMAGE}

COPY --from=ghcr.io/astral-sh/uv:0.11.11 /uv /uvx /bin/

RUN apt-get update && \
    apt-get install -y --no-install-recommends haproxy && \
    rm -rf /var/lib/apt/lists/*

# Replace the base image's pip-installed amd-aiter wheel with a git
# checkout at AITER_VERSION so this image and the SGLang ROCm image
# (docker/sglang/Dockerfile.rocm) build against the same upstream
# commit, driven by one pin in scripts/sync-repos.sh. The wheel ships
# compiled .so artifacts; the reinstall further down recompiles them
# against the patched source. git init + remote add + shallow fetch +
# checkout (instead of `git clone`) is what gives us fine control over
# fetch depth: --depth 1 pulls just the tip, since `git am` does not
# need history.
ARG AITER_VERSION=cdcfa833bdf554ca75594c90dde4316ea9b50199
RUN uv pip uninstall --python /usr/bin/python3 amd-aiter || true && \
    mkdir -p /opt/aiter && cd /opt/aiter && \
    git init -q && \
    git remote add origin https://github.com/ROCm/aiter.git && \
    git fetch --depth 1 origin ${AITER_VERSION} && \
    git checkout -f FETCH_HEAD && \
    git submodule update --init --recursive --depth 1

# Apply local AITER patches (base + vllm tier). The tier model and
# byte-stability rationale live in docs/patches.md; see also the SGLang
# ROCm Dockerfile which patches the same base/ tier and a sibling
# `sglang` tier against the same AITER_VERSION pin. Capture AITER's
# post-patch HEAD to /etc/vllm-shim/aiter-cache-key so the shim runtime
# namespaces AITER's JIT .so cache by AITER+patches version: bumping
# AITER OR editing a patch rotates the cache namespace and AITER
# recompiles from the new source instead of silently loading a stale
# .so from the PV. See vllm_shim.cli.rocm_perf.aiter_cache_key for the
# read side.
COPY patches/ /tmp/patches/
COPY scripts/ /tmp/scripts/
RUN bash /tmp/scripts/apply-patches.sh aiter vllm /opt/aiter && \
    mkdir -p /etc/vllm-shim && \
    git -C /opt/aiter rev-parse --short=12 HEAD \
        > /etc/vllm-shim/aiter-cache-key && \
    rm -rf /tmp/patches /tmp/scripts

# Build and install AITER from the patched checkout into the base
# image's Python (where vLLM lives). Non-editable so the compiled .so
# artifacts land in site-packages, not /opt/aiter/build.
RUN uv pip install --no-cache --python /usr/bin/python3 /opt/aiter

# vllm-shim lives in its own 3.12 venv so the vllm-entrypoints stub never
# lands in the base image's Python (which is where real vLLM is installed).
# If both shared an interpreter, importing vllm.entrypoints.openai.api_server
# would resolve to the stub and bounce back into the shim entrypoint.
RUN uv venv /opt/shim --python 3.12

COPY pyproject.toml uv.lock /src/
COPY packages /src/packages
RUN uv pip install --no-cache --python /opt/shim/bin/python \
        /src/packages/vllm-shim \
        /src/packages/vllm-entrypoints

# PATH ordering: /opt/shim/bin first so `vllm` resolves to our shim
# entrypoint; real vLLM lives in the base image's Python and the launcher
# reaches it via the absolute interpreter path in VLLM_BACKEND_PYTHON.
# AITER capture/restore activates automatically via probe_rocm() in the
# entrypoint; AMD's vLLM build uses AITER kernels, so the same capture
# path that helps SGLang on ROCm helps vLLM on ROCm.
ENV PATH="/opt/shim/bin:${PATH}"
ENV VLLM_SHIM_BACKEND="vllm"
ENV VLLM_BACKEND_PYTHON="/usr/bin/python3"

# Clear the base image's ENTRYPOINT (["vllm", "serve"]). The shim's
# console script is on PATH now, so callers can invoke `vllm serve ...`
# directly via CMD. Leaving the inherited ENTRYPOINT in place would
# prepend a second `vllm serve` to every invocation, making the literal
# word "vllm" become the model positional.
ENTRYPOINT []
