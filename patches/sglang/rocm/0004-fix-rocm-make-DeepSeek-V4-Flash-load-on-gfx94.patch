+            q,
+            kv_flat_main,
+            indices_main,
+            topk_length_main_tensor,
+            kv_flat_extra,
+            indices_extra,
+            topk_length_extra_tensor,
+            partial_output,
+            partial_lse,
+            sm_scale,
+            total_tokens,
+            _bucket_total_tokens(total_tokens),
+            h_q,
+            topk_main,
+            num_blocks_main,
+            block_size_main,
+            topk_extra,
+            num_blocks_extra,
+            block_size_extra,
+            s_q,
+            topk_per_split,
