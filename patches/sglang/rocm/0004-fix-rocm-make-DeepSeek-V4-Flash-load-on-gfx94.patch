+        mask=mask_h[:, None],
+    )
+    tl.store(
+        row_ptrs + (4 * TILE_SIZE + offs_tile[None, :]) * stride_po_d,
+        acc_4,
+        mask=mask_h[:, None],
+    )
+    tl.store(
+        row_ptrs + (5 * TILE_SIZE + offs_tile[None, :]) * stride_po_d,
+        acc_5,
+        mask=mask_h[:, None],
+    )
+    tl.store(
+        row_ptrs + (6 * TILE_SIZE + offs_tile[None, :]) * stride_po_d,
+        acc_6,
+        mask=mask_h[:, None],
+    )
+    tl.store(
+        row_ptrs + (7 * TILE_SIZE + offs_tile[None, :]) * stride_po_d,
+        acc_7,
+        mask=mask_h[:, None],
+    )
