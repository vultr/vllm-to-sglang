diff --git a/python/sglang/jit_kernel/deepseek_v4.py b/python/sglang/jit_kernel/deepseek_v4.py
index 6f9d772ad..0b3519599 100644
--- a/python/sglang/jit_kernel/deepseek_v4.py
+++ b/python/sglang/jit_kernel/deepseek_v4.py
@@ -653,6 +653,39 @@ def fused_rope(
 fused_rope_inplace = fused_rope
 
 
+_FUSED_Q_NORM_ROPE_TORCH = False  # test native Q kernel with kFusedQBlockSize=32 on ROCm
+
+
+def _fused_q_norm_rope_torch(
+    q_input: torch.Tensor,
+    q_output: torch.Tensor,
+    eps: float,
+    freqs_cis: torch.Tensor,
+    positions: torch.Tensor,
+) -> None:
+    # Pure-torch fallback for the JIT main_norm_rope.cuh Q kernel.
+    # The C++ kernel is authored for 32-wide warps and HSA-faults on
+    # gfx9 (64-wide wavefront), even with the SGL_SHFL_MASK widening and
+    # width=32 fixes elsewhere in this branch. Decompose as:
+    #   1. rmsnorm-self (no weight) over the full head_dim
+    #   2. RoPE on the trailing rope_dim slice via complex multiply
+    head_dim = q_input.shape[-1]
+    rope_dim_pairs = freqs_cis.shape[-1]
+    rope_dim = rope_dim_pairs * 2
+    nope_dim = head_dim - rope_dim
+    x_f32 = q_input.to(torch.float32)
+    rms = (x_f32 * x_f32).mean(dim=-1, keepdim=True).add(eps).rsqrt()
+    normed = x_f32 * rms
+    nope = normed[..., :nope_dim].to(q_input.dtype)
+    rope_pairs = normed[..., nope_dim:].reshape(*normed.shape[:-1], rope_dim_pairs, 2)
+    rope_complex = torch.view_as_complex(rope_pairs.contiguous())
+    sel_freqs = freqs_cis[positions.long()]
+    while sel_freqs.dim() < rope_complex.dim():
+        sel_freqs = sel_freqs.unsqueeze(-2)
+    rotated = torch.view_as_real(rope_complex * sel_freqs).flatten(-2).to(q_input.dtype)
+    torch.cat([nope, rotated], dim=-1, out=q_output)
+
+
 def fused_q_norm_rope(
     q_input: torch.Tensor,
     q_output: torch.Tensor,
@@ -660,6 +693,9 @@ def fused_q_norm_rope(
     freqs_cis: torch.Tensor,
     positions: torch.Tensor,
 ) -> None:
+    if _FUSED_Q_NORM_ROPE_TORCH:
+        _fused_q_norm_rope_torch(q_input, q_output, eps, freqs_cis, positions)
+        return
     freqs_real = torch.view_as_real(freqs_cis).flatten(-2)
     head_dim = q_input.shape[-1]
     rope_dim = freqs_real.shape[-1]
@@ -667,6 +703,65 @@ def fused_q_norm_rope(
     module.forward(q_input, q_output, freqs_real, positions, eps)
 
 
+_FUSED_Q_INDEXER_ROPE_HAD_QUANT_TORCH = torch.version.hip is not None
+
+
+def _hadamard_128(x: torch.Tensor) -> torch.Tensor:
+    """In-place 128-pt Walsh-Hadamard along the last dim, normalized by 1/sqrt(128)."""
+    out = x.clone()
+    n = out.shape[-1]
+    h = 1
+    while h < n:
+        out = out.view(*out.shape[:-1], n // (2 * h), 2, h)
+        a = out[..., 0, :].clone()
+        b = out[..., 1, :].clone()
+        out[..., 0, :] = a + b
+        out[..., 1, :] = a - b
+        out = out.view(*out.shape[:-3], n)
+        h <<= 1
+    return out * (n ** -0.5)
+
+
+def _fused_q_indexer_rope_hadamard_quant_torch(
+    q_input: torch.Tensor,
+    weight: torch.Tensor,
+    weight_scale: float,
+    freqs_cis: torch.Tensor,
+    positions: torch.Tensor,
+) -> Tuple[torch.Tensor, torch.Tensor]:
+    # Pure-torch fallback for main_norm_rope.cuh::FusedQIndexerRopeHadamardQuant.
+    # Replicates: RoPE on the trailing rope_dim, 128-pt Hadamard, per-warp
+    # (== per (token, head)) max -> FP8 quant + weights_out scale.
+    # q_input: (B, H, head_dim=128)
+    # weight: (B, H), weight_scale: float
+    # freqs_cis: (max_pos, rope_dim_pairs) complex
+    # positions: (B,) int
+    B, H, head_dim = q_input.shape
+    assert head_dim == 128
+    rope_pairs = freqs_cis.shape[-1]
+    rope_dim = rope_pairs * 2
+    nope_dim = head_dim - rope_dim
+    fp8_max = 448.0
+
+    x = q_input.float()
+    if rope_dim > 0:
+        rope = x[..., nope_dim:].reshape(B, H, rope_pairs, 2)
+        rope_complex = torch.view_as_complex(rope.contiguous())
+        sel_freqs = freqs_cis[positions.long()]
+        while sel_freqs.dim() < rope_complex.dim():
+            sel_freqs = sel_freqs.unsqueeze(-2)
+        rotated = torch.view_as_real(rope_complex * sel_freqs).flatten(-2)
+        x = torch.cat([x[..., :nope_dim], rotated], dim=-1)
+
+    h = _hadamard_128(x)
+    abs_max = h.abs().amax(dim=-1).clamp(min=1e-4)
+    scale_raw = abs_max / fp8_max
+    inv_scale = scale_raw.reciprocal()
+    q_fp8 = (h * inv_scale.unsqueeze(-1)).clamp(-fp8_max, fp8_max).to(torch.float8_e4m3fnuz)
+    weights_out = (weight.float() * float(weight_scale) * scale_raw).unsqueeze(-1)
+    return q_fp8, weights_out
+
+
 def fused_q_indexer_rope_hadamard_quant(
     q_input: torch.Tensor,
     weight: torch.Tensor,
