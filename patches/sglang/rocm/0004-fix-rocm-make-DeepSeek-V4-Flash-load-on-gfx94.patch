+# Split-K Attention for Large TopK
+# ============================================================================
+def run_splitk_unified_attention(
+    q_reshaped,
+    gathered_kv,
+    invalid_mask,
+    d_v,
+    sm_scale,
+    total_tokens,
+    h_q,
+    total_topk,
+    d_qk,
+    attn_sink=None,
+    split_k=4,
