@@ -5,6 +5,16 @@
 #include <sgl_kernel/utils.cuh>
 #include <sgl_kernel/warp.cuh>
 
+// Map the cudaMemcpyAsync/cudaMemcpyHostToDevice host-side calls below to
+// their hipMemcpyAsync/hipMemcpyHostToDevice equivalents on ROCm. hipify-style
+// aliases that the broader SGLang CUDA headers normally provide are not
+// pulled in here because this TU is compiled as a standalone JIT object.
+#ifdef USE_ROCM
+#include <hip/hip_runtime.h>
+#define cudaMemcpyAsync hipMemcpyAsync
+#define cudaMemcpyHostToDevice hipMemcpyHostToDevice
+#endif
+
 #include <sgl_kernel/deepseek_v4/compress_v2.cuh>
 
 #include <dlpack/dlpack.h>
@@ -104,7 +114,12 @@ SGL_DEVICE uint32_t warp_inclusive_sum(uint32_t lane_id, uint32_t val) {
   static_assert(device::kWarpThreads == 32);
 #pragma unroll
   for (uint32_t offset = 1; offset < 32; offset *= 2) {
-    uint32_t n = __shfl_up_sync(0xFFFFFFFF, val, offset);
+    // width=32 is load-bearing: HIP's default __shfl_*_sync width is warpSize
+    // (64 on gfx9), but this prefix-sum is built for 32-lane segments. Without
+    // explicit width=32, lanes 32-63 receive shuffled values from the upper
+    // half of the wavefront and the per-lane prefix sums go to wrong offsets,
+    // which downstream c_plan kernels turn into OOB writes / HSA faults.
+    uint32_t n = __shfl_up_sync(SGL_SHFL_MASK(0xFFFFFFFF), val, offset, 32);
     if (lane_id >= offset) val += n;
   }
   return val;
@@ -115,7 +130,7 @@ SGL_DEVICE uint32_t warp_inclusive_sum(uint32_t lane_id, uint32_t val) {
 SGL_DEVICE uint32_t warp_reduce_max_u32(uint32_t val) {
 #pragma unroll
   for (uint32_t mask = 16; mask > 0; mask >>= 1) {
-    val = max(val, __shfl_xor_sync(0xFFFFFFFF, val, mask, 32));
+    val = max(val, __shfl_xor_sync(SGL_SHFL_MASK(0xFFFFFFFF), val, mask, 32));
   }
   return val;
 }
@@ -123,7 +138,7 @@ SGL_DEVICE uint32_t warp_reduce_max_u32(uint32_t val) {
 SGL_DEVICE uint32_t warp_reduce_min_u32(uint32_t val) {
 #pragma unroll
   for (uint32_t mask = 16; mask > 0; mask >>= 1) {
-    val = min(val, __shfl_xor_sync(0xFFFFFFFF, val, mask, 32));
