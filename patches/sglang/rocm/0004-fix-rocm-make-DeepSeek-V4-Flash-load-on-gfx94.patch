+        row_ptrs + (TILE_SIZE + offs_tile[None, :]) * stride_po_d,
+        acc_1,
+        mask=mask_h[:, None],
+    )
+    tl.store(
+        row_ptrs + (2 * TILE_SIZE + offs_tile[None, :]) * stride_po_d,
+        acc_2,
+        mask=mask_h[:, None],
+    )
