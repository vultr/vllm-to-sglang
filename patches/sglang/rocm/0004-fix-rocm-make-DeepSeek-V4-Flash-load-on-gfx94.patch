+                Indices_Extra
+                + pid_t * stride_idx_extra_t
+                + offs_n_local * stride_idx_extra_k
+            )
+            indices = tl.load(idx_ptrs, mask=mask_n, other=-1)
+
+            is_invalid = indices == -1
+            if HAS_TOPK_LENGTH_EXTRA:
