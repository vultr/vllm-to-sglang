+    kv_cache_size_extra = stride_kv_block_extra * num_blocks_extra
+    disable_buffer_ops = (
+        kv_cache_size_main > BUFFER_OPS_DISABLE_THRESHOLD
+        or kv_cache_size_extra > BUFFER_OPS_DISABLE_THRESHOLD
+    )
+
