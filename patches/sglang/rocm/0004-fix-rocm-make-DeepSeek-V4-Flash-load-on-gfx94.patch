+    stride_plse_s_64 = tl.cast(stride_plse_s, tl.int64)
+    stride_plse_t_64 = tl.cast(stride_plse_t, tl.int64)
+    lse_ptrs = (
+        PartialLSE
+        + pid_k * stride_plse_s_64
+        + pid_t_64 * stride_plse_t_64
+        + offs_h * stride_plse_h
+    )
+    tl.store(lse_ptrs, lse, mask=mask_h)
