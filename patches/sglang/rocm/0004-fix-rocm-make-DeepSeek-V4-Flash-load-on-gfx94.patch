+            invalid_mask,
+            d_v,
+            sm_scale,
+            total_tokens,
+            h_q,
+            total_topk,
+            d_qk,
+            attn_sink=attn_sink,
+            chunk_size=32768,
+        )
+
+    return output.view(b, s_q, h_q, d_v), lse.view(b, s_q, h_q).transpose(1, 2)
