@@ -21,12 +21,25 @@ using deepseek_v4::fp8::cast_to_ue8m0;
 using deepseek_v4::fp8::inv_scale_ue8m0;
 using deepseek_v4::fp8::pack_fp8;
 
-// 4 warps per block: warp-per-(token, head) work-item dispatch (Q kernel).
+// On gfx9 (64-wide wavefronts), 4 "32-thread warps" per Q block pack 2
+// work-items per wavefront. The divergent control flow between the two
+// warps in a wavefront is what's HSAIL-faulting on gfx942 even after the
+// shfl mask widening / width=32 fixes. Shrink Q to 1 warp per block so
+// each wavefront owns exactly 1 work-item (upper 32 lanes inactive at
+// dispatch), eliminating the intra-wavefront warp divergence. K kernel
+// structure (7 fp8 warps + 1 rope warp = 8 total) can't be shrunk
+// without restructuring its FlashMLA write layout; left at 256 and
+// routed via torch fallback on ROCm.
+#ifdef USE_ROCM
+constexpr uint32_t kFusedQBlockSize = 32;
+#else
 constexpr uint32_t kFusedQBlockSize = 128;
+#endif
+constexpr uint32_t kFusedKBlockSize = 256;
+// 4 warps per block: warp-per-(token, head) work-item dispatch (Q kernel).
 constexpr uint32_t kFusedQNumWarps = kFusedQBlockSize / device::kWarpThreads;
 
 // 8 warps per block: block-per-token work-item dispatch (K kernel).
-constexpr uint32_t kFusedKBlockSize = 256;
 constexpr uint32_t kFusedKNumWarps = kFusedKBlockSize / device::kWarpThreads;
 
 #define Q_KERNEL __global__ __launch_bounds__(kFusedQBlockSize, 16)
@@ -506,7 +519,7 @@ Q_KERNEL void fused_q_indexer_rope_hadamard_quant(const __grid_constant__ FusedQ
     for (uint32_t mask = 1; mask < kWarpThreads; mask <<= 1) {
 #pragma unroll
       for (int i = 0; i < kVecSize; ++i) {
-        const float other = __shfl_xor_sync(0xFFFFFFFFu, data[i], mask, kWarpThreads);
+        const float other = __shfl_xor_sync(SGL_SHFL_MASK(0xFFFFFFFFu), data[i], mask, kWarpThreads);
         data[i] = (lane_id & mask) ? (other - data[i]) : (data[i] + other);
       }
     }
