+                _process_kv_block_aggressive(
+                    kv_block_base,
+                    nope_rope_offset,
+                    scale_base_offset,
+                    valid,
+                    valid_2d,
+                    q_0,
+                    q_1,
+                    q_2,
+                    q_3,
+                    q_4,
+                    q_5,
+                    q_6,
+                    q_7,
+                    acc_0,
+                    acc_1,
+                    acc_2,
+                    acc_3,
+                    acc_4,
+                    acc_5,
+                    acc_6,
+                    acc_7,
+                    m_i,
+                    l_i,
+                    offs_tile,
+                    sm_scale,
+                    TILE_SIZE,
+                    D_NOPE,
+                    LOG2E,
+                    BLOCK_H,
+                    BLOCK_N,
