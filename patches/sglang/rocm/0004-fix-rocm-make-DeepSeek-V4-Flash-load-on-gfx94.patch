+    tl.store(row_ptrs + offs_tile[None, :] * stride_po_d, acc_0, mask=mask_h[:, None])
+    tl.store(
+        row_ptrs + (TILE_SIZE + offs_tile[None, :]) * stride_po_d,
+        acc_1,
+        mask=mask_h[:, None],
