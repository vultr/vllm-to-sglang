+"""Config wrapper for the Kimi-K2 EAGLE3 draft model.
+
+The festr2/kimi-k2.6-eagle3-mla-fp8 checkpoint declares `model_type: "kimi_k2"`
+with a flat DeepSeek-V2/V3-style config (q_lora_rank, kv_lora_rank, MLA head
+dims, etc.) at the top level (NOT wrapped under `text_config` like the K2.5
+multimodal target). It needs its own registered model_type so AutoConfig can
+load it without falling back to remote code or the multimodal wrapper.
+
+Inherits from transformers' DeepseekV3Config when available so the MLA-related
+fields land on attributes the SGLang DeepseekV2AttentionMLA constructor
+expects, and falls back to PretrainedConfig (which accepts arbitrary kwargs)
+on transformers builds that haven't shipped DeepseekV3Config yet.
+"""
+
+try:
+    from transformers import DeepseekV3Config as _BaseConfig
+except ImportError:  # pragma: no cover
+    from transformers.configuration_utils import PretrainedConfig as _BaseConfig
+
+
+class KimiK2DraftConfig(_BaseConfig):
+    """Flat-style config used by Kimi-K2 EAGLE3 draft checkpoints."""
+
+    model_type = "kimi_k2"
