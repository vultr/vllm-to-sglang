diff --git a/python/sglang/srt/models/deepseek_v2_eagle3.py b/python/sglang/srt/models/deepseek_v2_eagle3.py
new file mode 100644
index 0000000..0b156f1
--- /dev/null
+++ b/python/sglang/srt/models/deepseek_v2_eagle3.py
@@ -0,0 +1,552 @@
+"""EAGLE3 speculative-decoding draft model for DeepSeek-V2/V3 MLA targets.
+
+Ports the layout of `vllm/model_executor/models/deepseek_eagle3.py` from
+vllm-project/vllm into SGLang. Used when the base model is a DeepSeek-V2/V3
+or Kimi-K2-family MLA model and the operator wants EAGLE3 speculative
+decoding via a draft trained on top of that base.
+
+Key design points (matching the vLLM reference and the SGLang LlamaEagle3 layer):
+  - Exactly one decoder layer (EAGLE3 protocol).
+  - The decoder layer's MLA attention sees a 2*hidden_size input (the concat
+    of the input-token embedding with the carried hidden state) on the only
+    layer. We achieve this by passing 2*hidden_size to DeepseekV2AttentionMLA's
+    constructor; that sizes fused_qkv_a_proj_with_mqa (or q_proj +
+    kv_a_proj_with_mqa) to accept the wider input.
+  - MLP, not MoE, on every layer. This matches both the vLLM reference and
+    the published Kimi K2 EAGLE3 draft checkpoints.
+  - The model carries an `fc` linear that projects three target aux hidden
+    states (concatenated to 3 * hidden_size) down to hidden_size before the
+    decoder layer runs.
+
+Weight loader handles the EAGLE3-specific bits:
+  - `d2t` (draft-to-target id table) is decoded into a `hot_token_id` index
+    consumed by SGLang's EAGLE worker.
+  - `t2d` is dropped (vLLM also drops it).
+  - Names from the checkpoint can land as `midlayer.*` (vLLM-style) or
+    `layers.0.*` (HF-style). Both are normalized to `model.midlayer.*`.
+  - Stacked-param mapping fuses `q_a_proj` + `kv_a_proj_with_mqa` into
+    `fused_qkv_a_proj_with_mqa` and `gate_proj` + `up_proj` into
+    `gate_up_proj`, matching the SGLang DeepseekV2AttentionMLA / DeepseekV2MLP
+    parameter layout.
+"""
+
+import copy
+from typing import Iterable, Optional, Tuple
+
+import torch
+from torch import nn
+from transformers import PretrainedConfig
+
+from sglang.srt.distributed import get_pp_group
+from sglang.srt.layers.layernorm import RMSNorm
+from sglang.srt.layers.linear import (
+    ColumnParallelLinear,
+    ReplicatedLinear,
+)
+from sglang.srt.layers.communicator import AttentionInputs, get_attn_tp_context
+from sglang.srt.layers.logits_processor import LogitsProcessor, LogitsProcessorOutput
+from sglang.srt.layers.quantization.base_config import QuantizationConfig
+from sglang.srt.layers.vocab_parallel_embedding import (
+    ParallelLMHead,
+    VocabParallelEmbedding,
+)
+from sglang.srt.model_executor.forward_batch_info import ForwardBatch, PPProxyTensors
+from sglang.srt.model_loader.weight_utils import default_weight_loader
+from sglang.srt.models.deepseek_v2 import (
+    DeepseekV2AttentionMLA,
+    DeepseekV2ForCausalLM,
+    DeepseekV2MLP,
+)
+from sglang.srt.utils import BumpAllocator, add_prefix
+
+
+class DeepseekV2Eagle3DecoderLayer(nn.Module):
+    """The single EAGLE3 decoder layer for a DeepSeek MLA-style base model.
+
+    Concatenates the input embedding and the carried hidden state along the
+    feature dimension (yielding 2*hidden_size) and feeds that into MLA's
+    input projections. MLP (not MoE) follows.
+    """
+
+    def __init__(
+        self,
+        config: PretrainedConfig,
+        layer_id: int = 0,
+        quant_config: Optional[QuantizationConfig] = None,
+        prefix: str = "",
+    ) -> None:
+        super().__init__()
+        self.hidden_size = config.hidden_size
+        rope_theta = getattr(config, "rope_theta", 10000.0)
+        rope_scaling = getattr(config, "rope_scaling", None)
+        max_position_embeddings = getattr(config, "max_position_embeddings", 8192)
+
+        # Build the MLA block with the model's normal hidden_size. That keeps
+        # o_proj (and every other internal projection sized off hidden_size)
+        # correct. Then we surgically resize only the *input* projection(s) to
+        # accept the concatenated embeds+hidden_states (2 * hidden_size) that
+        # the EAGLE3 layer feeds in. The output of attention is still
+        # hidden_size; only the input width changes.
+        attn_prefix = add_prefix("self_attn", prefix)
+        self.self_attn = DeepseekV2AttentionMLA(
+            config=config,
+            hidden_size=config.hidden_size,
+            num_heads=config.num_attention_heads,
+            qk_nope_head_dim=config.qk_nope_head_dim,
+            qk_rope_head_dim=config.qk_rope_head_dim,
+            v_head_dim=config.v_head_dim,
+            q_lora_rank=(
+                config.q_lora_rank if getattr(config, "q_lora_rank", None) else None
+            ),
+            kv_lora_rank=config.kv_lora_rank,
+            rope_theta=rope_theta,
+            rope_scaling=rope_scaling,
+            max_position_embeddings=max_position_embeddings,
+            quant_config=quant_config,
+            layer_id=layer_id,
+            prefix=attn_prefix,
+        )
+
+        # Override the input-side projections to accept 2 * hidden_size.
+        if getattr(config, "q_lora_rank", None) is not None:
+            # fused path (matches the deepseek_v2 MLA construction).
+            self.self_attn.fused_qkv_a_proj_with_mqa = ReplicatedLinear(
+                2 * config.hidden_size,
+                config.q_lora_rank + config.kv_lora_rank + config.qk_rope_head_dim,
+                bias=False,
+                quant_config=quant_config,
+                prefix=add_prefix("fused_qkv_a_proj_with_mqa", attn_prefix),
+            )
+        else:
+            self.self_attn.q_proj = ColumnParallelLinear(
+                2 * config.hidden_size,
+                config.num_attention_heads
+                * (config.qk_nope_head_dim + config.qk_rope_head_dim),
+                bias=False,
+                quant_config=quant_config,
+                prefix=add_prefix("q_proj", attn_prefix),
+            )
+            self.self_attn.kv_a_proj_with_mqa = ReplicatedLinear(
+                2 * config.hidden_size,
+                config.kv_lora_rank + config.qk_rope_head_dim,
+                bias=False,
+                quant_config=quant_config,
+                prefix=add_prefix("kv_a_proj_with_mqa", attn_prefix),
+            )
+
+        self.mlp = DeepseekV2MLP(
+            hidden_size=config.hidden_size,
+            intermediate_size=config.intermediate_size,
+            hidden_act=config.hidden_act,
+            quant_config=quant_config,
+            prefix=add_prefix("mlp", prefix),
+        )
+
+        self.input_layernorm = RMSNorm(config.hidden_size, eps=config.rms_norm_eps)
+        self.post_attention_layernorm = RMSNorm(
+            config.hidden_size, eps=config.rms_norm_eps
+        )
+        self.hidden_norm = RMSNorm(config.hidden_size, eps=config.rms_norm_eps)
+
+    def forward(
+        self,
+        positions: torch.Tensor,
+        embeds: torch.Tensor,
+        hidden_states: torch.Tensor,
+        forward_batch: ForwardBatch,
+        residual: Optional[torch.Tensor],
+        zero_allocator: BumpAllocator,
+    ) -> Tuple[torch.Tensor, torch.Tensor]:
+        # The residual the rest of the layer adds back is the hidden_state we
+        # received, not a post-norm version of it. This matches both vLLM's
+        # _norm_after_residual path (the default when norm_before_residual is
+        # not set in the config) and SGLang's LlamaDecoderLayer Eagle3 layout.
+        residual = hidden_states
+        embeds = self.input_layernorm(embeds)
+        hidden_states = self.hidden_norm(hidden_states)
+        hidden_states = torch.cat([embeds, hidden_states], dim=-1)
+
+        # MLA's forward_absorb_prepare reads from get_attn_tp_context().attn_inputs_,
+        # which the normal DeepseekV2DecoderLayer fills via LayerCommunicator.prepare_attn.
+        # We bypass that path, so install the AttentionInputs directly.
+        get_attn_tp_context().set_attn_inputs(
+            AttentionInputs(
+                hidden_states, forward_batch, self.self_attn.prepare_qkv_latent
+            )
+        )
+
+        hidden_states = self.self_attn(
+            positions=positions,
+            hidden_states=hidden_states,
+            forward_batch=forward_batch,
+            zero_allocator=zero_allocator,
+        )
+
+        hidden_states, residual = self.post_attention_layernorm(
+            hidden_states, residual
+        )
+        hidden_states = self.mlp(hidden_states)
+        return hidden_states, residual
+
+
+class DeepseekV2Eagle3Model(nn.Module):
+    def __init__(
+        self,
+        config: PretrainedConfig,
+        quant_config: Optional[QuantizationConfig] = None,
+        prefix: str = "",
+    ) -> None:
+        super().__init__()
+        self.config = config
+        self.vocab_size = config.vocab_size
+
+        self.embed_tokens = VocabParallelEmbedding(
+            config.vocab_size,
+            config.hidden_size,
+            prefix=add_prefix("embed_tokens", prefix),
+        )
+
+        # Combine three target aux hidden states (concat along feature dim,
+        # so total width = 3 * target_hidden_size) into the draft hidden_size.
+        self.hidden_size_in = getattr(
+            config, "target_hidden_size", config.hidden_size
+        )
+        self.fc = torch.nn.Linear(
+            self.hidden_size_in * 3,
+            config.hidden_size,
+            bias=getattr(config, "bias", False),
+        )
+
+        self.midlayer = DeepseekV2Eagle3DecoderLayer(
+            config,
+            layer_id=0,
+            quant_config=quant_config,
+            prefix=add_prefix("midlayer", prefix),
+        )
+
+        self.norm = RMSNorm(config.hidden_size, eps=config.rms_norm_eps)
+
+        # post_load_weights iterates self.model.layers[start..end]. Expose the
+        # single EAGLE3 layer as a one-element list so the parent's MLA weight
+        # split (w_kc/w_vc) finds it without bespoke reimplementation.
+        self.layers = [self.midlayer]
+        self.start_layer = 0
+        self.end_layer = 1
+
+    def forward(
+        self,
+        input_ids: torch.Tensor,
+        positions: torch.Tensor,
+        forward_batch: ForwardBatch,
+        input_embeds: Optional[torch.Tensor] = None,
+        pp_proxy_tensors: Optional[PPProxyTensors] = None,
+    ) -> Tuple[torch.Tensor, list]:
+        if input_embeds is None:
+            embeds = self.embed_tokens(input_ids)
+        else:
+            embeds = input_embeds
+
+        hidden_states = forward_batch.spec_info.hidden_states
+        if hidden_states.shape[-1] != embeds.shape[-1]:
+            # Target sent the concatenated 3-aux hidden state; project it down.
+            hidden_states = self.fc(hidden_states)
+
+        # Idle batch: nothing to compute, return as-is so collectives align.
+        if hidden_states.shape[0] == 0:
+            return hidden_states, [hidden_states]
+
+        # MLA forward requires a per-call BumpAllocator for fp32 scratch tensors.
+        # One EAGLE3 layer => 2 entries; double when TBO is active to match
+        # what deepseek_v2.DeepseekV2Model.forward does for 2-batch overlap.
+        zero_allocator = BumpAllocator(
+            buffer_size=2 * (2 if forward_batch.can_run_tbo else 1),
+            dtype=torch.float32,
+            device=hidden_states.device,
+        )
+
+        residual = None
+        hidden_states, residual = self.midlayer(
+            positions,
+            embeds,
+            hidden_states,
+            forward_batch,
+            residual,
+            zero_allocator,
+        )
+
+        hidden_states_to_logits, hidden_states_to_aux = self.norm(
+            hidden_states, residual
+        )
+        return hidden_states_to_logits, [hidden_states_to_aux]
+
+
+class Eagle3DeepseekV2ForCausalLM(DeepseekV2ForCausalLM):
+    """EAGLE3 draft for DeepSeek-V2/V3 (and DeepSeek-MLA Kimi-K2-family) targets."""
+
+    def __init__(
+        self,
+        config: PretrainedConfig,
+        quant_config: Optional[QuantizationConfig] = None,
+        prefix: str = "",
+    ) -> None:
+        nn.Module.__init__(self)
+        self.config = config
+        self.quant_config = quant_config
+        self.pp_group = get_pp_group()
+
+        if config.num_hidden_layers != 1:
+            raise ValueError(
+                f"EAGLE3 currently only supports 1 layer (got {config.num_hidden_layers})"
+            )
+
+        self.model = DeepseekV2Eagle3Model(
+            config,
+            quant_config=quant_config,
+            prefix=add_prefix("model", prefix),
+        )
+
+        self.load_lm_head_from_target = False
+        if getattr(config, "tie_word_embeddings", False):
+            self.lm_head = self.model.embed_tokens
+        else:
+            if getattr(config, "draft_vocab_size", None) is None:
+                self.load_lm_head_from_target = True
+                config.draft_vocab_size = config.vocab_size
+            self.lm_head = ParallelLMHead(
+                config.draft_vocab_size,
+                config.hidden_size,
+                quant_config=quant_config,
+                prefix=add_prefix("lm_head", prefix),
+            )
+
+        config_ = copy.deepcopy(config)
+        # The draft logits processor advertises the draft vocab size, not the
+        # target's. The d2t/hot_token_id mapping in the EAGLE worker remaps
+        # logits back into the target vocab space.
+        config_.vocab_size = config_.draft_vocab_size
+        self.logits_processor = LogitsProcessor(config_)
+
+        self.capture_aux_hidden_states = True
+        self.hot_token_id = None
+
+    def get_hot_token_id(self):
+        return self.hot_token_id
+
+    @torch.no_grad()
+    def forward(
+        self,
+        input_ids: torch.Tensor,
+        positions: torch.Tensor,
+        forward_batch: ForwardBatch,
+        input_embeds: torch.Tensor = None,
+        get_embedding: bool = False,
+        pp_proxy_tensors: Optional[PPProxyTensors] = None,
+    ) -> LogitsProcessorOutput:
+        # Override DeepseekV2ForCausalLM.forward, which references NSA-specific
+        # attributes (nsa_enable_prefill_cp, etc.) that EAGLE3 drafts don't have.
+        hidden_states = self.model(
+            input_ids,
+            positions,
+            forward_batch,
+            input_embeds,
+            pp_proxy_tensors=pp_proxy_tensors,
+        )
+
+        aux_hidden_states = None
+        if self.capture_aux_hidden_states:
+            hidden_states, aux_hidden_states = hidden_states
+
+        return self.logits_processor(
+            input_ids,
+            hidden_states,
+            self.lm_head,
+            forward_batch,
+            aux_hidden_states,
+        )
+
+    def set_embed(self, embed):
+        if (
+            hasattr(self.config, "target_hidden_size")
+            and self.config.target_hidden_size != self.config.hidden_size
+        ):
+            return
+        del self.model.embed_tokens.weight
+        self.model.embed_tokens.weight = embed
+        torch.cuda.empty_cache()
+        torch.cuda.synchronize()
+
+    def load_weights(self, weights: Iterable[Tuple[str, torch.Tensor]]) -> None:
+        params_dict = dict(self.named_parameters())
+
+        # gate_proj + up_proj fuse into gate_up_proj (MergedColumnParallelLinear,
+        # weight_loader signature is (param, loaded_weight, shard_id)).
+        stacked_params_mapping = [
+            (".gate_up_proj", ".gate_proj", 0),
+            (".gate_up_proj", ".up_proj", 1),
+        ]
+
+        # q_a_proj + kv_a_proj_with_mqa fuse into fused_qkv_a_proj_with_mqa
+        # (ReplicatedLinear, weight_loader takes only (param, loaded_weight)).
+        # We cache the partner weight and concat along output dim once both
+        # have arrived, mirroring deepseek_v2 / longcat_flash's logic.
+        fuse_qkv_a_proj = (
+            getattr(self.config, "q_lora_rank", None) is not None
+        )
+        cached_a_proj: dict = {} if fuse_qkv_a_proj else None
+
+        def _normalize(name: str) -> str:
+            if "midlayer." in name:
+                return name.replace("midlayer.", "model.midlayer.")
+            if name.startswith("layers.0."):
+                return "model.midlayer." + name[len("layers.0.") :]
+            if name.startswith("model.layers.0."):
+                return "model.midlayer." + name[len("model.layers.0.") :]
+            if not name.startswith(("model.", "lm_head")):
+                return "model." + name
+            return name
+
+        for name, loaded_weight in weights:
+            if "t2d" in name:
+                continue
+            if "d2t" in name:
+                self.hot_token_id = loaded_weight + torch.arange(
+                    loaded_weight.shape[0]
+                )
+                continue
+
+            name = _normalize(name)
+
+            # Stacked gate/up fusion.
+            stacked_hit = False
+            for target_attr, ckpt_substr, shard_id in stacked_params_mapping:
+                if ckpt_substr not in name:
+                    continue
+                mapped = name.replace(ckpt_substr, target_attr)
+                if mapped in params_dict:
+                    param = params_dict[mapped]
+                    weight_loader = getattr(
+                        param, "weight_loader", default_weight_loader
+                    )
+                    weight_loader(param, loaded_weight, shard_id)
+                    stacked_hit = True
+                break
+            if stacked_hit:
+                continue
+
+            # qkv_a output-dim fusion: buffer q_a_proj.* and kv_a_proj_with_mqa.*
+            # tensors here; the actual fused dispatch (including FP8 re-quant
+            # under a unified scale) happens in a deferred pass after the main
+            # loop, once we have weight AND weight_scale AND input_scale all in
+            # hand for both halves.
+            if fuse_qkv_a_proj and (
+                "q_a_proj" in name or "kv_a_proj_with_mqa" in name
+            ):
+                cached_a_proj[name] = loaded_weight
+                continue
+
+            if name in params_dict:
+                param = params_dict[name]
+                weight_loader = getattr(param, "weight_loader", default_weight_loader)
+                weight_loader(param, loaded_weight)
+
+        # Deferred fused_qkv_a_proj_with_mqa dispatch: concatenating two FP8
+        # tensors that were quantized under *different* per-tensor weight_scales
+        # and storing a single max() scale corrupts whichever half had the
+        # smaller scale (its FP8 codes dequantize at the wrong magnitude). To
+        # avoid that, we dequantize each half to bf16, concat, then re-quantize
+        # under a unified scale before handing it to the linear's weight_loader.
+        if fuse_qkv_a_proj and cached_a_proj:
+            self._dispatch_fused_qkv_a_proj(cached_a_proj, params_dict)
+
+        # Build w_kc/w_vc and (re)quantize kv_b_proj into per-tensor scales for
+        # the MLA absorb path. Without this, self_attn.w_kc stays None and the
+        # MLA forward hits "'NoneType' object has no attribute 'dtype'".
+        self.post_load_weights()
+
+    def _dispatch_fused_qkv_a_proj(
+        self,
+        cached: dict,
+        params_dict: dict,
+    ) -> None:
+        def _load(param, tensor):
+            loader = getattr(param, "weight_loader", default_weight_loader)
+            loader(param, tensor)
+        # Group cached entries by their suffix (weight / weight_scale /
+        # input_scale) and parent prefix.
+        groups: dict = {}
+        for full_name, tensor in cached.items():
+            if ".q_a_proj." in full_name:
+                base = full_name.replace(".q_a_proj.", ".")
+                half = "q"
+            elif ".kv_a_proj_with_mqa." in full_name:
+                base = full_name.replace(".kv_a_proj_with_mqa.", ".")
+                half = "kv"
+            else:
+                continue
+            # base is now "<prefix>.<suffix>" where suffix is weight /
+            # weight_scale / input_scale.
+            prefix, _, suffix = base.rpartition(".")
+            groups.setdefault(prefix, {})[(half, suffix)] = tensor
+
+        for prefix, parts in groups.items():
+            q_w = parts.get(("q", "weight"))
+            kv_w = parts.get(("kv", "weight"))
+            q_ws = parts.get(("q", "weight_scale"))
+            kv_ws = parts.get(("kv", "weight_scale"))
+            q_is = parts.get(("q", "input_scale"))
+            kv_is = parts.get(("kv", "input_scale"))
+            if q_w is None or kv_w is None:
+                continue
+
+            fused_prefix = prefix + ".fused_qkv_a_proj_with_mqa"
+            weight_param = params_dict.get(fused_prefix + ".weight")
+            if weight_param is None:
+                continue
+
+            target_dtype = weight_param.dtype
+            is_fp8 = target_dtype in (
+                torch.float8_e4m3fn,
+                torch.float8_e4m3fnuz,
+            )
+
+            if is_fp8 and q_ws is not None and kv_ws is not None:
+                # Dequant -> concat -> re-quant under a unified scale.
+                q_real = q_w.to(torch.float32) * q_ws.to(torch.float32)
+                kv_real = kv_w.to(torch.float32) * kv_ws.to(torch.float32)
+                fused_real = torch.cat([q_real, kv_real], dim=0)
+                fp8_max = torch.finfo(target_dtype).max
+                new_scale = (
+                    fused_real.abs().max() / fp8_max
+                ).clamp_min(1e-12)
+                fused_fp8 = (fused_real / new_scale).clamp(-fp8_max, fp8_max).to(
+                    target_dtype
+                )
+                _load(weight_param, fused_fp8)
+                ws_param = params_dict.get(fused_prefix + ".weight_scale")
+                if ws_param is not None:
+                    _load(
+                        ws_param,
+                        new_scale.to(ws_param.dtype).reshape(ws_param.shape),
+                    )
+            else:
+                fused_w = torch.cat([q_w, kv_w], dim=0)
+                _load(weight_param, fused_w)
+                if q_ws is not None and kv_ws is not None:
+                    ws_param = params_dict.get(fused_prefix + ".weight_scale")
+                    if ws_param is not None:
+                        _load(ws_param, torch.maximum(q_ws, kv_ws))
+
+            # input_scale: both halves consume the same hidden_states so their
+            # static input scales were calibrated against the same distribution
+            # and we keep max(), which is a no-op when they agree.
+            is_param = params_dict.get(fused_prefix + ".input_scale")
+            if is_param is not None and q_is is not None and kv_is is not None:
+                _load(is_param, torch.maximum(q_is, kv_is))
+
+
+class Eagle3DeepseekV3ForCausalLM(Eagle3DeepseekV2ForCausalLM):
+    """Same EAGLE3 architecture; named separately so SGLang's registry can
+    resolve checkpoints that advertise the V3-flavoured arch string."""
+
+
+EntryClass = [Eagle3DeepseekV2ForCausalLM, Eagle3DeepseekV3ForCausalLM]
