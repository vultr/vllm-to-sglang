+++ b/python/sglang/srt/layers/quantization/quark/schemes/triton_mxfp4_dispatch.py
@@ -0,0 +1,373 @@
+"""Triton MXFP4 MoE dispatch for gfx942 (MI300X).
+
+Bypasses AITER's fused_moe() dispatcher (which routes to CK kernels
+that are compile-time excluded on gfx942) and calls AITER's Triton
+MXFP4 MoE kernels directly. The Triton kernels use tl.dot_scaled,
+which decomposes FP4 ops into BF16 upcast + BF16 MFMA on gfx942.
+
+CUDA-graph-capture safe: all GPU tensors are pre-allocated in a
+workspace cache on the first (warmup) call and reused on subsequent
+calls. No torch.tensor/empty/zeros/full calls happen after warmup,
+which is the property graph capture needs.
+
+Called from QuarkW4A4MXFp4MoE.apply_weights when
+``_use_triton_mxfp4_fallback`` is set (AITER enabled and not gfx95).
+The companion MoRI EP integration lives in ep_moe/layer.py and is
+gated separately on SGLANG_MORI_MXFP4_TRITON; non-EP can be
+validated in isolation first.
+"""
+
+import logging
+from types import SimpleNamespace
+from typing import Optional
+
+import torch
+import triton.language as tl
+
+logger = logging.getLogger(__name__)
+
+_triton_ops_loaded = False
+_fused_moe_mxfp4 = None
+_fused_moe_mxfp4_silu = None
+_align_kernels = None
+
+
+def _load_triton_ops():
+    global _triton_ops_loaded, _fused_moe_mxfp4, _fused_moe_mxfp4_silu
+    global _align_kernels
+    if _triton_ops_loaded:
+        return
+    from aiter.ops.triton.moe.moe_op_mxfp4 import fused_moe_mxfp4
+    from aiter.ops.triton.moe.moe_op_mxfp4_silu_fused import fused_moe_mxfp4_silu
+    from aiter.ops.triton._triton_kernels.moe.moe_align_block_size import (
+        _moe_align_block_size_stage1_kernel,
+        _moe_align_block_size_stage2_kernel,
+        _moe_align_block_size_stage3_kernel,
+        _moe_align_block_size_stage4_kernel,
+    )
+
+    _fused_moe_mxfp4 = fused_moe_mxfp4
+    _fused_moe_mxfp4_silu = fused_moe_mxfp4_silu
+    _align_kernels = (
+        _moe_align_block_size_stage1_kernel,
+        _moe_align_block_size_stage2_kernel,
+        _moe_align_block_size_stage3_kernel,
+        _moe_align_block_size_stage4_kernel,
+    )
+    _triton_ops_loaded = True
+    logger.info("Loaded Triton MXFP4 MoE kernels for gfx942 fallback")
+
+
+_STAGE1_CONFIG = {
+    "BLOCK_SIZE_M": 64,
+    "BLOCK_SIZE_N": 128,
+    "BLOCK_SIZE_K": 128,
+    "GROUP_SIZE_M": 8,
+}
+_STAGE2_CONFIG = {
+    "BLOCK_SIZE_M": 64,
+    "BLOCK_SIZE_N": 128,
+    "BLOCK_SIZE_K": 128,
+    "GROUP_SIZE_M": 8,
+}
+_BLOCK_M = 64
+
+
+def _ceil_div(a, b):
+    return (a + b - 1) // b
+
+
+_workspace_cache: dict = {}
+
+# Bucket schedule for the workspace cache. The cache key includes M
+# (per-DP token count), and `max_padded`-derived tensors scale with M;
+# without bucketing every unique runtime M allocates a new ~hundreds-of-
+# MB entry that is never freed, and the cache grows unboundedly under
+# DP attention (which produces a wide spread of per-step M values).
+# Bucketing M to a small fixed schedule caps the cache at
+# O(len(_M_BUCKETS)) entries per (top_k, num_experts, hidden_dim,
+# inter_dim, device) tuple. The spacing up to 128 matches the
+# cuda_graph_bs cadence closely enough that adjacent batch sizes share
+# entries; powers of two above 128 cover the eager prefill range up to
+# _MAX_M_PER_CALL. Both warmup capture and steady-state route through
+# the same bucketing, so a cache HIT during graph replay returns the
+# exact tensor the graph was captured against. The cache stays bounded
+# because triton_mxfp4_moe chunks any M > _MAX_M_PER_CALL before
+# entering _get_workspace, so the fall-through `return M` is a defense
+# against future callers and never fires under chunked dispatch.
+_M_BUCKETS = (
+    1, 8, 16, 24, 32, 40, 48, 56, 64, 72, 80, 88, 96, 104, 112, 120, 128,
+    256, 512, 1024, 2048, 4096, 8192, 16384,
+)
+
+
+def _bucket_m(M: int) -> int:
+    for b in _M_BUCKETS:
+        if M <= b:
+            return b
+    return M
+
+
+# Diagnostic counters to verify the suspected unbounded growth of
+# _workspace_cache. Every unique M (token batch) seen at runtime
+# allocates a new entry of ~hundreds of MB; DP attention varies M
+# per step, so this can leak HBM monotonically. The counters log on
+# every miss and emit a periodic summary on every call so HBM growth
+# can be correlated with cache size over time. Remove once the leak
+# is fixed.
+_workspace_cache_total_bytes = 0
+_workspace_cache_calls = 0
+_workspace_cache_hits = 0
+_WORKSPACE_SUMMARY_EVERY = 500
+
+
+def _ws_bytes(num_experts, max_padded, max_blocks, hidden_dim, inter_dim, M, dtype):
+    elem = torch.empty((), dtype=dtype).element_size()
+    f32 = 4
+    i32 = 4
+    return (
+        f32  # a_scale
+        + num_experts * f32  # b13_scale
+        + num_experts * f32  # b2_scale
+        + max_padded * i32  # sorted_token_ids
+        + max_blocks * i32  # expert_ids
+        + 1 * i32  # num_tokens_post_padded
+        + (num_experts + 1) * num_experts * i32  # tokens_cnts
+        + (num_experts + 1) * i32  # cumsum
+        + max_padded * inter_dim * elem  # stage1_out
+        + max_padded * hidden_dim * elem  # stage2_out
+        + max_padded * f32  # stage2_topk_weights
+        + M * hidden_dim * elem  # output
+    )
+
+
+def _get_workspace(M, top_k, num_experts, hidden_dim, inter_dim, device, dtype):
+    global _workspace_cache_total_bytes, _workspace_cache_calls, _workspace_cache_hits
+    _workspace_cache_calls += 1
+    M_b = _bucket_m(M)
+    key = (M_b, top_k, num_experts, hidden_dim, inter_dim, device)
+    if key in _workspace_cache:
+        _workspace_cache_hits += 1
+        if _workspace_cache_calls % _WORKSPACE_SUMMARY_EVERY == 0:
+            logger.info(
+                "MXFP4 workspace summary: calls=%d hits=%d misses=%d "
+                "entries=%d total=%.1f MB",
+                _workspace_cache_calls,
+                _workspace_cache_hits,
+                _workspace_cache_calls - _workspace_cache_hits,
+                len(_workspace_cache),
+                _workspace_cache_total_bytes / (1024 * 1024),
+            )
+        return _workspace_cache[key]
+
+    num_valid = M_b * top_k
+    max_padded = num_valid + num_experts * _BLOCK_M - top_k
+    max_blocks = _ceil_div(max_padded, _BLOCK_M)
+
+    ws = SimpleNamespace(
+        num_valid=num_valid,
+        max_padded=max_padded,
+        max_blocks=max_blocks,
+        a_scale=torch.tensor(1.0, dtype=torch.float32, device=device),
+        b13_scale=torch.ones(num_experts, dtype=torch.float32, device=device),
+        b2_scale=torch.ones(num_experts, dtype=torch.float32, device=device),
+        sorted_token_ids=torch.empty(max_padded, dtype=torch.int32, device=device),
+        expert_ids=torch.empty(max_blocks, dtype=torch.int32, device=device),
+        num_tokens_post_padded=torch.empty(1, dtype=torch.int32, device=device),
+        tokens_cnts=torch.empty(
+            (num_experts + 1, num_experts), dtype=torch.int32, device=device
+        ),
+        cumsum=torch.empty(num_experts + 1, dtype=torch.int32, device=device),
+        stage1_out=torch.empty(max_padded, inter_dim, dtype=dtype, device=device),
+        stage2_out=torch.empty(1, max_padded, hidden_dim, dtype=dtype, device=device),
+        stage2_topk_weights=torch.empty(
+            max_padded, 1, dtype=torch.float32, device=device
+        ),
+        output=torch.empty(M_b, hidden_dim, dtype=dtype, device=device),
+    )
+    _workspace_cache[key] = ws
+    entry_bytes = _ws_bytes(
+        num_experts, max_padded, max_blocks, hidden_dim, inter_dim, M_b, dtype
+    )
+    _workspace_cache_total_bytes += entry_bytes
+    logger.warning(
+        "MXFP4 workspace MISS: M=%d (bucket=%d) top_k=%d max_padded=%d "
+        "entry=%.1f MB (cache: %d entries, %.1f MB total, %d calls, %d hits)",
+        M,
+        M_b,
+        top_k,
+        max_padded,
+        entry_bytes / (1024 * 1024),
+        len(_workspace_cache),
+        _workspace_cache_total_bytes / (1024 * 1024),
+        _workspace_cache_calls,
+        _workspace_cache_hits,
+    )
+    return ws
+
+
+def _moe_align_block_size_capture_safe(topk_ids, num_experts, block_size, ws):
+    numel = topk_ids.numel()
+    tokens_per_thread = _ceil_div(numel, num_experts)
+    grid = (num_experts,)
+    k1, k2, k3, k4 = _align_kernels
+
+    ws.tokens_cnts.zero_()
+    ws.cumsum.zero_()
+
+    k1[grid](topk_ids, ws.tokens_cnts, num_experts, numel, tokens_per_thread)
+    k2[grid](ws.tokens_cnts, num_experts)
+    k3[(1,)](
+        ws.num_tokens_post_padded,
+        ws.tokens_cnts,
+        ws.cumsum,
+        num_experts,
+        block_size,
+    )
+    k4[grid](
+        topk_ids,
+        ws.sorted_token_ids,
+        ws.expert_ids,
+        ws.tokens_cnts,
+        ws.cumsum,
+        num_experts,
+        block_size,
+        numel,
+        tokens_per_thread,
+    )
+
+
+# Cap M passed to a single dispatch call. The workspace's stage2_out
+# tensor scales as max_padded * hidden_dim; for top_k=8 routed-expert
+# MoEs with hidden_dim=7168, a single call at M=78886 requires a
+# ~10 GB allocation that hipMalloc cannot satisfy on top of in-flight
+# activations under concurrent prefill, hanging the GPU. Chunking the
+# call along the M dimension keeps every per-call workspace bounded;
+# the per-chunk overhead is dominated by kernel-launch latency and is
+# negligible relative to the GEMM work each chunk does.
+_MAX_M_PER_CALL = 16384
+
+
+def triton_mxfp4_moe(
+    hidden_states: torch.Tensor,
+    w13_weight: torch.Tensor,
+    w2_weight: torch.Tensor,
+    w13_weight_scale: torch.Tensor,
+    w2_weight_scale: torch.Tensor,
+    topk_weights: torch.Tensor,
+    topk_ids: torch.Tensor,
+    expert_mask: Optional[torch.Tensor] = None,
+) -> torch.Tensor:
+    M_total = hidden_states.shape[0]
+    if M_total <= _MAX_M_PER_CALL:
+        return _triton_mxfp4_moe_call(
+            hidden_states,
+            w13_weight,
+            w2_weight,
+            w13_weight_scale,
+            w2_weight_scale,
+            topk_weights,
+            topk_ids,
+            expert_mask,
+        )
+
+    hidden_dim = hidden_states.shape[1]
+    out = torch.empty(
+        M_total, hidden_dim, dtype=hidden_states.dtype, device=hidden_states.device
+    )
+    for start in range(0, M_total, _MAX_M_PER_CALL):
+        end = min(start + _MAX_M_PER_CALL, M_total)
+        chunk_out = _triton_mxfp4_moe_call(
+            hidden_states[start:end],
+            w13_weight,
+            w2_weight,
+            w13_weight_scale,
+            w2_weight_scale,
+            topk_weights[start:end],
+            topk_ids[start:end],
+            expert_mask,
+        )
+        out[start:end].copy_(chunk_out)
+    return out
+
+
+def _triton_mxfp4_moe_call(
+    hidden_states: torch.Tensor,
+    w13_weight: torch.Tensor,
+    w2_weight: torch.Tensor,
+    w13_weight_scale: torch.Tensor,
+    w2_weight_scale: torch.Tensor,
+    topk_weights: torch.Tensor,
+    topk_ids: torch.Tensor,
+    expert_mask: Optional[torch.Tensor] = None,
+) -> torch.Tensor:
+    _load_triton_ops()
+
+    M, hidden_dim = hidden_states.shape
+    top_k = topk_ids.shape[1]
+    num_experts = w13_weight.shape[0]
+    inter_dim = w13_weight.shape[1] // 2
+    device = hidden_states.device
+    dtype = hidden_states.dtype
+    num_valid_tokens = M * top_k
+
+    ws = _get_workspace(M, top_k, num_experts, hidden_dim, inter_dim, device, dtype)
+
+    ws.sorted_token_ids.fill_(num_valid_tokens)
+    _moe_align_block_size_capture_safe(topk_ids, num_experts, _BLOCK_M, ws)
+
+    ws.stage1_out.zero_()
+    _fused_moe_mxfp4_silu(
+        A=hidden_states,
+        B=w13_weight,
+        C=ws.stage1_out,
+        A_scale=ws.a_scale,
+        B_scale=ws.b13_scale,
+        A_mx_scale=None,
+        B_mx_scale=w13_weight_scale,
+        topk_weights=topk_weights,
+        topk_ids=topk_ids,
+        sorted_token_ids=ws.sorted_token_ids,
+        expert_ids=ws.expert_ids,
+        num_tokens_post_padded=ws.num_tokens_post_padded,
+        mul_routed_weight=False,
+        top_k=top_k,
+        swizzle_mx_a=False,
+        swizzle_mx_b=False,
+        config=_STAGE1_CONFIG,
+        compute_type=tl.bfloat16,
+    )
+
+    ws.stage2_out.zero_()
+    flat_weights = topk_weights.reshape(-1)
+    ws.stage2_topk_weights.zero_()
+    ws.stage2_topk_weights[:num_valid_tokens, 0] = flat_weights
+    _fused_moe_mxfp4(
+        A=ws.stage1_out,
+        B=w2_weight,
+        C=ws.stage2_out,
+        A_scale=ws.a_scale,
+        B_scale=ws.b2_scale,
+        A_mx_scale=None,
+        B_mx_scale=w2_weight_scale,
+        topk_weights=ws.stage2_topk_weights,
+        topk_ids=topk_ids,
+        sorted_token_ids=ws.sorted_token_ids,
+        expert_ids=ws.expert_ids,
+        num_tokens_post_padded=ws.num_tokens_post_padded,
+        mul_routed_weight=True,
+        top_k=1,
+        swizzle_mx_a=False,
+        swizzle_mx_b=False,
+        config=_STAGE2_CONFIG,
+        compute_type=tl.bfloat16,
+    )
+
+    stage2_flat = ws.stage2_out.squeeze(0)
+    valid_out = stage2_flat[:num_valid_tokens].view(M, top_k, hidden_dim)
+    # ws.output is sized for the cache bucket (>= M); slice to the actual
+    # M before reducing. The slice is a view, not a new allocation, and
+    # graph capture handles strided views of cached tensors correctly.
+    out = ws.output[:M]
+    torch.sum(valid_out, dim=1, out=out)
+    return out
