From 363130c10ed93353f5d8578403b71c9720d10fb6 Mon Sep 17 00:00:00 2001
From: vllm-shim <vllm-shim@local>
Date: Thu, 1 Jan 2026 00:00:00 +0000
Subject: [PATCH 4/5] fix(quark): bound MXFP4 workspace cache by bucketing M

_workspace_cache is keyed on M (per-DP token count). Under DP attention
M varies per step across a wide range, so every unique runtime M
allocates a new ~350-650 MB workspace entry that is never freed. With
sustained mixed-length traffic the cache grew to 98 entries / ~50 GiB
per DP in ~13 minutes against a Kimi-K2.6-MXFP4 backend, exhausting the
192 GiB HBM and crashing every TP worker with HIP out-of-memory.

Bucket M to a 25-entry fixed schedule (1, multiples of 8 up to 128,
then powers of two up to 32768) before keying the cache and sizing the
allocation, then slice ws.output to the actual M on return. The
schedule's fine-grained head matches the cuda_graph_bs cadence so
adjacent batch sizes share workspaces; the coarse tail covers the
eager prefill range out to chunked_prefill_size. Capture and steady-
state both bucket identically, so a cache hit during graph replay
returns the exact tensor the graph was captured against. The slice on
return is a view of the cached output tensor; no allocation happens at
call time, preserving graph-capture safety.

Caps the cache at O(len(_M_BUCKETS)) entries per (top_k, num_experts,
hidden_dim, inter_dim, device) tuple. For Kimi-K2.6 sizing the worst-
case per-entry cost is ~1.1 GiB at the M=4096 bucket; summed across all
25 buckets the cache is bounded at ~2.5 GiB per DP rather than the
unbounded growth observed previously.

Diagnostic counters from the previous patch are retained so a re-run
of the same workload can confirm the cache plateaus at <= 25 entries.

Not upstreamed.
---
 .../quark/schemes/triton_mxfp4_dispatch.py    | 48 +++++++++++++++----
 1 file changed, 40 insertions(+), 8 deletions(-)

diff --git a/python/sglang/srt/layers/quantization/quark/schemes/triton_mxfp4_dispatch.py b/python/sglang/srt/layers/quantization/quark/schemes/triton_mxfp4_dispatch.py
index 72e2209e0..469f24bde 100644
--- a/python/sglang/srt/layers/quantization/quark/schemes/triton_mxfp4_dispatch.py
+++ b/python/sglang/srt/layers/quantization/quark/schemes/triton_mxfp4_dispatch.py
@@ -79,6 +79,32 @@ def _ceil_div(a, b):
 
 _workspace_cache: dict = {}
 
+# Bucket schedule for the workspace cache. The cache key includes M
+# (per-DP token count), and `max_padded`-derived tensors scale with M;
+# without bucketing every unique runtime M allocates a new ~hundreds-of-
+# MB entry that is never freed, and the cache grows unboundedly under
+# DP attention (which produces a wide spread of per-step M values).
+# Bucketing M to a small fixed schedule caps the cache at
+# O(len(_M_BUCKETS)) entries per (top_k, num_experts, hidden_dim,
+# inter_dim, device) tuple. The spacing up to 128 matches the
+# cuda_graph_bs cadence closely enough that adjacent batch sizes share
+# entries; powers of two above 128 cover the eager prefill range out to
+# the largest plausible chunked_prefill_size. Both warmup capture and
+# steady-state route through the same bucketing, so a cache HIT during
+# graph replay returns the exact tensor the graph was captured against.
+_M_BUCKETS = (
+    1, 8, 16, 24, 32, 40, 48, 56, 64, 72, 80, 88, 96, 104, 112, 120, 128,
+    256, 512, 1024, 2048, 4096, 8192, 16384, 32768,
+)
+
+
+def _bucket_m(M: int) -> int:
+    for b in _M_BUCKETS:
+        if M <= b:
+            return b
+    return _M_BUCKETS[-1]
+
+
 # Diagnostic counters to verify the suspected unbounded growth of
 # _workspace_cache. Every unique M (token batch) seen at runtime
 # allocates a new entry of ~hundreds of MB; DP attention varies M
@@ -115,7 +141,8 @@ def _ws_bytes(num_experts, max_padded, max_blocks, hidden_dim, inter_dim, M, dty
 def _get_workspace(M, top_k, num_experts, hidden_dim, inter_dim, device, dtype):
     global _workspace_cache_total_bytes, _workspace_cache_calls, _workspace_cache_hits
     _workspace_cache_calls += 1
-    key = (M, top_k, num_experts, hidden_dim, inter_dim, device)
+    M_b = _bucket_m(M)
+    key = (M_b, top_k, num_experts, hidden_dim, inter_dim, device)
     if key in _workspace_cache:
         _workspace_cache_hits += 1
         if _workspace_cache_calls % _WORKSPACE_SUMMARY_EVERY == 0:
@@ -130,7 +157,7 @@ def _get_workspace(M, top_k, num_experts, hidden_dim, inter_dim, device, dtype):
             )
         return _workspace_cache[key]
 
-    num_valid = M * top_k
+    num_valid = M_b * top_k
     max_padded = num_valid + num_experts * _BLOCK_M - top_k
     max_blocks = _ceil_div(max_padded, _BLOCK_M)
 
@@ -153,17 +180,18 @@ def _get_workspace(M, top_k, num_experts, hidden_dim, inter_dim, device, dtype):
         stage2_topk_weights=torch.empty(
             max_padded, 1, dtype=torch.float32, device=device
         ),
-        output=torch.empty(M, hidden_dim, dtype=dtype, device=device),
+        output=torch.empty(M_b, hidden_dim, dtype=dtype, device=device),
     )
     _workspace_cache[key] = ws
     entry_bytes = _ws_bytes(
-        num_experts, max_padded, max_blocks, hidden_dim, inter_dim, M, dtype
+        num_experts, max_padded, max_blocks, hidden_dim, inter_dim, M_b, dtype
     )
     _workspace_cache_total_bytes += entry_bytes
     logger.warning(
-        "MXFP4 workspace MISS: M=%d top_k=%d max_padded=%d entry=%.1f MB "
-        "(cache: %d entries, %.1f MB total, %d calls, %d hits)",
+        "MXFP4 workspace MISS: M=%d (bucket=%d) top_k=%d max_padded=%d "
+        "entry=%.1f MB (cache: %d entries, %.1f MB total, %d calls, %d hits)",
         M,
+        M_b,
         top_k,
         max_padded,
         entry_bytes / (1024 * 1024),
@@ -280,5 +308,9 @@ def triton_mxfp4_moe(
 
     stage2_flat = ws.stage2_out.squeeze(0)
     valid_out = stage2_flat[:num_valid_tokens].view(M, top_k, hidden_dim)
-    torch.sum(valid_out, dim=1, out=ws.output)
-    return ws.output
+    # ws.output is sized for the cache bucket (>= M); slice to the actual
+    # M before reducing. The slice is a view, not a new allocation, and
+    # graph capture handles strided views of cached tensors correctly.
+    out = ws.output[:M]
+    torch.sum(valid_out, dim=1, out=out)
+    return out
