From 2c7b9723e48c8564557f58bad3e9d29eae410930 Mon Sep 17 00:00:00 2001
From: Matt Harris <mharris@vultr.com>
Date: Fri, 22 May 2026 01:00:02 +0000
Subject: [PATCH 4/6] fix(eagle-draft): SWA buffer + translate-loc guards for
 hybrid-SWA EAGLE on MiMoV2

Two related fixes for running EAGLE speculative decoding on
hybrid-SWA target models (MiMoV2 ships an MTP block whose attention
uses a sliding window), both required for the draft worker to
forward through that MTP layer without crashing:

1. python/sglang/srt/layers/attention/triton_backend.py

   The Triton attention backend's draft-extend init paths (regular,
   cuda-graph capture, and cuda-graph replay) never populate
   forward_metadata.window_kv_indices or the related window_kv_*
   fields. That works for pure full-attention or pure SWA models, but
   breaks for hybrid-SWA architectures like MiMoV2: when the EAGLE
   draft worker forwards through its SWA MTP block, forward_extend
   pulls window_kv_indices=None and the Triton compile fails to
   resolve None.type against a tl.load(kv_indices + ...) call. This
   patch mirrors the target_verify SWA setup into all three
   is_draft_extend branches.

2. python/sglang/srt/speculative/multi_layer_eagle_draft_extend_cuda_graph_runner.py

   The multi-step draft-extend chain (--speculative-num-steps>=2)
   unconditionally calls
   self.model_runner.token_to_kv_pool.translate_loc_from_full_to_swa(
   next_buffers.out_cache_loc) inside the next-buffer copy. For
   MiMoV2 the draft model_runner's pool is MHATokenToKVPool, which
   does not expose that method, so the chain init raises
   AttributeError: 'MHATokenToKVPool' object has no attribute
   'translate_loc_from_full_to_swa' during cuda graph capture and
   the scheduler aborts before serving any request. With
   --speculative-num-steps=1 the chain branch was never entered so
   the bug only surfaces once multi-step EAGLE is enabled. Guard the
   translation behind hasattr; the SWA cache locator is unused on
   the non-SWA draft path, and the buffer remains at its capture-
   time init value.
---
 .../srt/layers/attention/triton_backend.py    | 61 ++++++++++++++++++-
 ...er_eagle_draft_extend_cuda_graph_runner.py | 17 ++++--
 2 files changed, 73 insertions(+), 5 deletions(-)

diff --git a/python/sglang/srt/layers/attention/triton_backend.py b/python/sglang/srt/layers/attention/triton_backend.py
index f6d27e9..70d0231 100644
--- a/python/sglang/srt/layers/attention/triton_backend.py
+++ b/python/sglang/srt/layers/attention/triton_backend.py
@@ -430,6 +430,29 @@ class TritonAttnBackend(AttentionBackend):
             num_kv_splits = None
             attn_logits = None
             attn_lse = None
+
+            # Hybrid-SWA models (e.g. MiMoV2) route their MTP block through an
+            # SWA-attention layer, so the draft-extend forward needs the same
+            # window_kv_* buffers as target_verify. Without this the SWA branch
+            # in forward_extend pulls window_kv_indices=None and Triton fails
+            # to compile the load against a NoneType pointer.
+            if self.sliding_window_size is not None and self.sliding_window_size > 0:
+                bs = len(forward_batch.req_pool_indices)
+                (
+                    window_kv_indptr,
+                    window_kv_indices,
+                    window_kv_lens,
+                    window_kv_offsets,
+                ) = update_sliding_window_buffer(
+                    self.window_kv_indptr,
+                    self.req_to_token,
+                    self.sliding_window_size,
+                    forward_batch.seq_lens,
+                    forward_batch.req_pool_indices,
+                    bs,
+                    self.device,
+                    self.token_to_kv_pool_allocator,
+                )
         else:
             kv_indptr[1 : bs + 1] = torch.cumsum(
                 forward_batch.extend_prefix_lens, dim=0
@@ -711,6 +734,25 @@ class TritonAttnBackend(AttentionBackend):
                 kv_indices,
                 self.req_to_token.stride(0),
             )
+
+            # Hybrid-SWA models (e.g. MiMoV2) route their MTP block through an
+            # SWA-attention layer, so the captured draft-extend forward needs
+            # window_kv_* buffers populated alongside the full-attention ones.
+            if self.sliding_window_size is not None and self.sliding_window_size > 0:
+                window_kv_indices = self.cuda_graph_window_kv_indices
+                window_kv_indptr, window_kv_indices, _, _ = (
+                    update_sliding_window_buffer_cuda_graph(
+                        self.window_kv_indptr,
+                        window_kv_indices,
+                        self.req_to_token,
+                        self.sliding_window_size,
+                        seq_lens[:bs],
+                        req_pool_indices,
+                        bs,
+                        self.token_to_kv_pool_allocator,
+                    )
+                )
+
             custom_mask = None
             mask_indptr = None
             max_extend_len = num_tokens_per_bs
@@ -859,13 +901,30 @@ class TritonAttnBackend(AttentionBackend):
             kv_indices = self.cuda_graph_kv_indices
             create_flashinfer_kv_indices_triton[(bs,)](
                 self.req_to_token,
-                req_pool_indices,
+                req_pool_indices[:bs],
                 seq_lens,
                 kv_indptr,
                 None,
                 kv_indices,
                 self.req_to_token.stride(0),
             )
+
+            # Hybrid-SWA models (e.g. MiMoV2): refresh the SWA buffers that the
+            # capture path also populates, so the replayed graph reads valid
+            # window_kv_indices when the draft model forwards through an SWA
+            # layer.
+            if self.sliding_window_size is not None and self.sliding_window_size > 0:
+                window_kv_indices = self.cuda_graph_window_kv_indices
+                update_sliding_window_buffer_cuda_graph(
+                    self.window_kv_indptr,
+                    window_kv_indices,
+                    self.req_to_token,
+                    self.sliding_window_size,
+                    seq_lens[:bs],
+                    req_pool_indices[:bs],
+                    bs,
+                    self.token_to_kv_pool_allocator,
+                )
         else:
             raise ValueError(
                 f"Invalid forward mode: {forward_mode=} for CUDA Graph replay."
diff --git a/python/sglang/srt/speculative/multi_layer_eagle_draft_extend_cuda_graph_runner.py b/python/sglang/srt/speculative/multi_layer_eagle_draft_extend_cuda_graph_runner.py
index 732bc3e..3725f20 100644
--- a/python/sglang/srt/speculative/multi_layer_eagle_draft_extend_cuda_graph_runner.py
+++ b/python/sglang/srt/speculative/multi_layer_eagle_draft_extend_cuda_graph_runner.py
@@ -494,11 +494,20 @@ class MultiLayerEagleDraftExtendCudaGraphRunner:
                     forward_batch.req_to_token_pool.req_to_token,
                     self.eagle_worker.req_to_hidden_states_pool,
                 )
-                next_buffers.swa_out_cache_loc.copy_(
-                    self.model_runner.token_to_kv_pool.translate_loc_from_full_to_swa(
-                        next_buffers.out_cache_loc
+                # Hybrid-SWA target models (e.g. MiMoV2) instantiate the EAGLE
+                # draft worker against a plain MHATokenToKVPool, which has no
+                # SWA index space. Skip the translation when the draft pool
+                # does not support it; swa_out_cache_loc stays at its capture-
+                # time init and is unused on the non-SWA path.
+                if hasattr(
+                    self.model_runner.token_to_kv_pool,
+                    "translate_loc_from_full_to_swa",
+                ):
+                    next_buffers.swa_out_cache_loc.copy_(
+                        self.model_runner.token_to_kv_pool.translate_loc_from_full_to_swa(
+                            next_buffers.out_cache_loc
+                        )
                     )
-                )
 
             forward_batch.out_cache_loc = output_cache_loc_backup
             forward_batch.spec_info.hidden_states = hidden_states_backup
